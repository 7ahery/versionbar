{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VersionBar",
  "identifier": "io.github.7ahery.versionbar",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popup",
        "title": "VersionBar",
        "width": 380,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Michael Tahery",
    "resources": {
      "../../core/pyproject.toml": "core/pyproject.toml",
      "../../core/uv.lock": "core/uv.lock",
      "../../core/.python-version": "core/.python-version",
      "../../core/LICENSE": "core/LICENSE",
      "../../core/README.md": "core/README.md",
      "../../core/src/": "core/src/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxMkQwRjJGNkZCRTRDNTMKUldSVFRMNXZMdzh0QVMwMTMyb3p3VVZSSjJRV05CU1hSTWtGamo0SmdRdFRpNXZQemdTdS9aeFMK",
      "endpoints": [
        "https://github.com/7ahery/versionbar/releases/latest/download/latest.json"
      ]
    }
  }
}
