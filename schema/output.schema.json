{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandOutput",
  "description": "Every document the CLI prints with --json. Scan results (list, show) carry schema_version 1, which changes only on breaking changes.",
  "anyOf": [
    {
      "$ref": "#/$defs/ScanResult"
    },
    {
      "$ref": "#/$defs/CaptureOutcome"
    },
    {
      "$ref": "#/$defs/CaptureFailure"
    }
  ],
  "$defs": {
    "CaptureFailure": {
      "additionalProperties": false,
      "description": "What `debug capture --json` prints when nothing was recorded.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/FailureOutcome"
        },
        "tool": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "tool",
        "message"
      ],
      "title": "CaptureFailure",
      "type": "object"
    },
    "CaptureOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "captured",
          "default": "captured",
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "tool",
        "destination",
        "exit_code"
      ],
      "title": "CaptureOutcome",
      "type": "object"
    },
    "FailureOutcome": {
      "enum": [
        "unknown-tool",
        "unsupported-os",
        "not-found",
        "timeout",
        "launch-error",
        "write-failed"
      ],
      "type": "string"
    },
    "Install": {
      "additionalProperties": false,
      "description": "One installation of a tool.",
      "properties": {
        "version": {
          "description": "The version as the tool prints it, vendor suffixes included.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "description": "`path`, or the id of the provider that reported the install.",
          "type": "string"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The manager whose shim serves this install, or null."
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Decoded version output the version was parsed from, or null."
        }
      },
      "required": [
        "version",
        "path",
        "source",
        "via",
        "raw"
      ],
      "title": "Install",
      "type": "object"
    },
    "OsName": {
      "enum": [
        "windows",
        "linux"
      ],
      "type": "string"
    },
    "ScanResult": {
      "additionalProperties": false,
      "description": "The result of one live scan: what `list --json` and `show --json` print.",
      "properties": {
        "schema_version": {
          "default": 1,
          "description": "Changes only on breaking changes to this format.",
          "type": "integer"
        },
        "scanned_at": {
          "format": "date-time",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/OsName"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "scanned_at",
        "platform",
        "tools"
      ],
      "title": "ScanResult",
      "type": "object"
    },
    "Tool": {
      "additionalProperties": false,
      "description": "One tool and every install of it that was found.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolStatus"
        },
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/Install"
            },
            {
              "type": "null"
            }
          ],
          "description": "The install that runs when you type the command, or null when there is none."
        },
        "installs": {
          "description": "Every install found, the active one first.",
          "items": {
            "$ref": "#/$defs/Install"
          },
          "type": "array"
        },
        "notes": {
          "default": [],
          "description": "Human-readable explanations for the status (why missing, what failed); not for parsing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "active",
        "installs",
        "notes"
      ],
      "title": "Tool",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "found",
        "missing",
        "error",
        "timeout"
      ],
      "type": "string"
    }
  }
}
